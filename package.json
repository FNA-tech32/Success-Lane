{
  "name": "success-lane",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node init && npm run dev",
    "dev": "node init && npm-run-all -p watch:css vite:dev",
    "predev": "npm-run-all i18n-compile build:css",
    "build": "node init && npm-run-all i18n-compile build:css && vite build",
    "preview": "vite preview",
    "vite:dev": "vite",
    "build:css": "node init && postcss src/theme/tailwind.css -o src/theme/index.css --config postcss",
    "watch:css": "postcss src/theme/tailwind.css -o src/theme/index.css --config postcss -w",
    "i18n-extract": "lingui extract",
    "i18n-compile": "lingui compile"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^1.2.36",
    "@fortawesome/free-brands-svg-icons": "^5.15.4",
    "@fortawesome/free-solid-svg-icons": "^5.15.4",
    "@fortawesome/react-fontawesome": "^0.1.19",
    "@lingui/macro": "^2.9.2",
    "@lingui/react": "^2.9.2",
    "@reach/router": "^1.3.4",
    "classnames": "^2.5.1",
    "path-browserify": "^1.0.1",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remark": "^10.0.1",
    "remark-react": "^5.0.0"
  },
  "devDependencies": {
    "@lingui/cli": "^2.9.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^9.8.8",
    "babel-plugin-macros": "^2.8.0",
    "glhd-tailwindcss-transitions": "^0.3.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^7.0.39",
    "postcss-cli": "^6.1.3",
    "sass": "^1.80.6",
    "tailwindcss": "0.7.4",
    "tailwindcss-plugins": "^0.1.2",
    "vite": "^5.4.11",
    "vite-plugin-svgr": "^4.3.0"
  }
}
